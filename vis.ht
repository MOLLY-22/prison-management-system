<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta content="width=device-width, initial-scale=1.0" name="viewport"><meta content="web_dashboard" name="shell-type"><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config = { darkMode: "class", theme: { extend: { "colors": { "tertiary-fixed": "#ffdcc3", "primary-container": "#0a2540", "primary-fixed": "#d2e4ff", "on-primary-container": "#768dad", "primary-fixed-dim": "#b0c8eb", "primary": "#000f22", "on-secondary": "#ffffff", "inverse-primary": "#b0c8eb", "error-container": "#ffdad6", "on-tertiary-fixed-variant": "#6e3900", "secondary-container": "#87c0fe", "on-tertiary": "#ffffff", "surface-tint": "#49607e", "on-surface": "#191c1e", "on-surface-variant": "#43474d", "on-primary": "#ffffff", "outline": "#74777e", "tertiary-fixed-dim": "#ffb77d", "secondary-fixed-dim": "#9ccaff", "on-error-container": "#93000a", "outline-variant": "#c4c6ce", "on-tertiary-container": "#d27200", "on-primary-fixed": "#001c37", "surface-container-low": "#f2f4f6", "on-secondary-fixed-variant": "#00497b", "inverse-on-surface": "#eff1f3", "surface-container-lowest": "#ffffff", "surface-variant": "#e0e3e5", "error": "#ba1a1a", "on-background": "#191c1e", "on-secondary-container": "#004e82", "surface-bright": "#f8f9fb", "tertiary": "#1c0a00", "surface-dim": "#d8dadc", "on-primary-fixed-variant": "#314865", "surface": "#f8f9fb", "inverse-surface": "#2d3133", "secondary-fixed": "#d0e4ff", "on-secondary-fixed": "#001d35", "background": "#f8f9fb", "secondary": "#1e629a", "on-tertiary-fixed": "#2f1500", "surface-container-highest": "#e0e3e5", "surface-container": "#eceef0", "on-error": "#ffffff", "surface-container-high": "#e6e8ea", "tertiary-container": "#3b1c00" }, "borderRadius": { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" }, "spacing": { "space-sm": "0.5rem", "space-lg": "1.5rem", "space-md": "1rem", "margin": "2rem", "space-xl": "2.5rem", "space-xs": "0.25rem", "gutter": "1.5rem" }, "fontFamily": { "display-lg-mobile": [ "Inter" ], "body-md": [ "Inter" ], "headline-sm": [ "Inter" ], "headline-md-mobile": [ "Inter" ], "body-lg": [ "Inter" ], "label-sm": [ "Inter" ], "body-sm": [ "Inter" ], "display-lg": [ "Inter" ], "headline-md": [ "Inter" ], "label-md": [ "Inter" ] }, "fontSize": { "display-lg-mobile": [ "28px", { "lineHeight": "36px", "letterSpacing": "-0.01em", "fontWeight": "700" } ], "body-md": [ "14px", { "lineHeight": "20px", "fontWeight": "400" } ], "headline-sm": [ "18px", { "lineHeight": "24px", "fontWeight": "600" } ], "headline-md-mobile": [ "20px", { "lineHeight": "28px", "fontWeight": "600" } ], "body-lg": [ "16px", { "lineHeight": "24px", "fontWeight": "400" } ], "label-sm": [ "12px", { "lineHeight": "16px", "fontWeight": "500" } ], "body-sm": [ "12px", { "lineHeight": "16px", "fontWeight": "400" } ], "display-lg": [ "36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" } ], "headline-md": [ "24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" } ], "label-md": [ "14px", { "lineHeight": "20px", "fontWeight": "500" } ] } } } }</script>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"></head><body class="bg-surface font-body-md text-on-surface"><aside class="fixed left-0 top-0 h-full w-72 bg-surface-container-low z-50 flex flex-col pt-space-md pb-space-lg border-r border-outline-variant/30"><div class="px-space-lg mb-space-lg flex items-center gap-space-sm"><span class="material-symbols-outlined text-primary text-[24px]">shield_locked</span><span class="text-headline-sm font-bold text-primary uppercase tracking-wider">CORP-SEC</span></div><nav class="flex-1 px-space-md space-y-space-xs" data-active-classes="bg-primary-container text-on-primary-container font-semibold rounded-lg"><a class="flex items-center px-space-md py-space-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" data-path="inmate-management" href="#"><span class="material-symbols-outlined mr-space-md text-[20px]">group</span>Inmate Management</a><a class="flex items-center px-space-md py-space-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" data-path="sentence-custody" href="#"><span class="material-symbols-outlined mr-space-md text-[20px]">gavel</span>Sentence &amp; Custody</a><a class="flex items-center px-space-md py-space-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" data-path="transfer-management" href="#"><span class="material-symbols-outlined mr-space-md text-[20px]">local_shipping</span>Transfer Management</a><a aria-current="page" class="flex items-center px-space-md py-space-sm transition-all bg-primary-container text-on-primary-container font-semibold rounded-lg" data-path="visitor-management" href="#"><span class="material-symbols-outlined mr-space-md text-[20px]">badge</span>Visitor Management</a><a class="flex items-center px-space-md py-space-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" data-path="release-discharge" href="#"><span class="material-symbols-outlined mr-space-md text-[20px]">lock_open</span>Release &amp; Discharge</a><a class="flex items-center px-space-md py-space-sm rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-all" data-path="user-access-control" href="#"><span class="material-symbols-outlined mr-space-md text-[20px]">admin_panel_settings</span>User &amp; Access Control</a></nav><div class="px-space-lg pt-space-md border-t border-outline-variant/30 text-label-sm text-on-surface-variant">Secure Gateway v4.2.0</div></aside><div class="pl-72"><header class="fixed top-0 left-72 right-0 h-16 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-space-lg border-b border-outline-variant/30"><div class="flex items-center gap-space-md"><div class="flex items-center gap-space-xs px-space-sm py-1 bg-surface-container rounded text-label-sm font-medium text-on-surface"><span class="w-2 h-2 rounded-full bg-secondary"></span>System Secure</div><div class="flex items-center gap-space-xs text-on-surface-variant text-label-sm"><span class="material-symbols-outlined text-[16px]">verified</span>Security Badge #SEC-992</div></div><div class="flex items-center gap-space-md"><div class="flex items-center gap-space-xs"><span class="text-label-sm text-on-surface-variant">Role:</span><select class="bg-surface-container border border-outline-variant text-label-sm rounded px-2 py-1 text-on-surface focus:outline-none"><option>Officer-in-Charge</option><option>Senior Officer</option><option>Gatekeeper</option></select></div><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></header><main class="relative pt-16 bg-surface min-h-screen"><div class="flex flex-col w-full">
<!-- Top Stats Bar & Alerts -->
<div class="px-space-lg pt-space-md pb-space-xs grid grid-cols-1 md:grid-cols-4 gap-space-md">
<div class="bg-surface-container-low p-space-md rounded-lg flex items-center justify-between">
<div>
<p class="text-label-sm text-on-surface-variant uppercase tracking-wider">Active Visitors on Site</p>
<p class="text-headline-md font-bold text-primary mt-1">42</p>
</div>
<div class="w-10 h-10 rounded-lg bg-secondary-fixed flex items-center justify-center text-secondary">
<span class="material-symbols-outlined">badge</span>
</div>
</div>
<div class="bg-surface-container-low p-space-md rounded-lg flex items-center justify-between">
<div>
<p class="text-label-sm text-on-surface-variant uppercase tracking-wider">Pending Check-Ins</p>
<p class="text-headline-md font-bold text-on-tertiary-container mt-1">7</p>
</div>
<div class="w-10 h-10 rounded-lg bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed-variant">
<span class="material-symbols-outlined">pending</span>
</div>
</div>
<div class="bg-surface-container-low p-space-md rounded-lg flex items-center justify-between">
<div>
<p class="text-label-sm text-on-surface-variant uppercase tracking-wider">Gatehouse Status</p>
<p class="text-headline-md font-bold text-secondary mt-1">SECURE</p>
</div>
<div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center text-primary">
<span class="material-symbols-outlined">lock</span>
</div>
</div>
<div class="bg-surface-container-low p-space-md rounded-lg flex items-center justify-between">
<div>
<p class="text-label-sm text-on-surface-variant uppercase tracking-wider">Today Total Logs</p>
<p class="text-headline-md font-bold text-primary mt-1">128</p>
</div>
<div class="w-10 h-10 rounded-lg bg-surface-container-high flex items-center justify-center text-on-surface">
<span class="material-symbols-outlined">history</span>
</div>
</div>
</div>
<!-- Main Content Grid -->
<div class="p-space-lg grid grid-cols-1 xl:grid-cols-12 gap-space-lg">
<!-- Left Column: Registration & Inmate Lookup (7 cols) -->
<div class="xl:col-span-7 space-y-space-lg">
<!-- Visitor Registration Form -->
<div class="bg-surface-container-low p-space-lg rounded-lg">
<div class="flex items-center justify-between mb-space-md">
<h2 class="text-headline-sm text-primary flex items-center gap-space-sm">
<span class="material-symbols-outlined text-secondary">person_add</span>
            Visitor Registration Form (FR-07)
          </h2>
<span class="text-label-sm text-on-surface-variant">Gatehouse Entry Port A</span>
</div>
<form class="space-y-space-md">
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block text-label-md font-medium text-on-surface mb-1">Full Name</label>
<input class="w-full bg-surface-container border border-outline-variant rounded p-2 text-body-md text-on-surface focus:outline-none focus:border-secondary" placeholder="e.g. Jonathan R. Vance" type="text">
</div>
<div>
<label class="block text-label-md font-medium text-on-surface mb-1">National ID / Passport</label>
<input class="w-full bg-surface-container border border-outline-variant rounded p-2 text-body-md text-on-surface focus:outline-none focus:border-secondary" placeholder="US-99482103-X" type="text">
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
<div>
<label class="block text-label-md font-medium text-on-surface mb-1">Contact Details</label>
<input class="w-full bg-surface-container border border-outline-variant rounded p-2 text-body-md text-on-surface focus:outline-none focus:border-secondary" placeholder="+1 (555) 019-2834" type="text">
</div>
<div>
<label class="block text-label-md font-medium text-on-surface mb-1">Relationship to Inmate</label>
<select class="w-full bg-surface-container border border-outline-variant rounded p-2 text-body-md text-on-surface focus:outline-none focus:border-secondary">
<option>Legal Counsel / Attorney</option>
<option>Immediate Family</option>
<option>Clergy / Spiritual Advisor</option>
<option>Authorized Official</option>
</select>
</div>
</div>
<div>
<label class="block text-label-md font-medium text-on-surface mb-1">Checked Items at Gate (Security Screening)</label>
<div class="grid grid-cols-2 md:grid-cols-4 gap-space-sm mt-2">
<label class="flex items-center gap-space-xs bg-surface-container p-2 rounded cursor-pointer">
<input class="w-4 h-4 text-primary rounded border-outline-variant" type="checkbox">
<span class="text-body-sm text-on-surface">Valid ID</span>
</label>
<label class="flex items-center gap-space-xs bg-surface-container p-2 rounded cursor-pointer">
<input class="w-4 h-4 text-primary rounded border-outline-variant" type="checkbox">
<span class="text-body-sm text-on-surface">Metal Detector Clr</span>
</label>
<label class="flex items-center gap-space-xs bg-surface-container p-2 rounded cursor-pointer">
<input class="w-4 h-4 text-primary rounded border-outline-variant" type="checkbox">
<span class="text-body-sm text-on-surface">No Electronics</span>
</label>
<label class="flex items-center gap-space-xs bg-surface-container p-2 rounded cursor-pointer">
<input class="w-4 h-4 text-primary rounded border-outline-variant" type="checkbox">
<span class="text-body-sm text-on-surface">Bag Tagged</span>
</label>
</div>
</div>
<div class="flex justify-end gap-space-sm pt-space-sm">
<button class="px-space-md py-2 border border-outline-variant text-on-surface text-label-md rounded hover:bg-surface-container-high transition-all" type="reset">Clear Form</button>
<button class="px-space-lg py-2 bg-primary text-on-primary text-label-md font-semibold rounded hover:bg-primary-container transition-all" type="button">Register &amp; Issue Pass</button>
</div>
</form>
</div>
<!-- Inmate Lookup & Gatekeeper Minimum Access (FR-11) -->

</div>
<!-- Right Column: Visitation Session Logging & Touch Controls (5 cols) -->
<div class="xl:col-span-5 space-y-space-lg">
<!-- Gatehouse Point-of-Duty Touch-Friendly Controls -->
<div class="bg-surface-container-low p-space-lg rounded-lg border-2 border-secondary/30">
<div class="flex items-center justify-between mb-space-md">
<h2 class="text-headline-sm text-primary flex items-center gap-space-sm">
<span class="material-symbols-outlined text-secondary">touch_app</span>
            Gatehouse Touch Controls
          </h2>
<span class="px-2 py-0.5 bg-secondary-fixed text-on-secondary-fixed text-label-sm rounded font-bold animate-pulse">LIVE PORT</span>
</div>
<div class="grid grid-cols-2 gap-space-md mb-space-md">
<button class="h-24 bg-primary text-on-primary rounded-xl flex flex-col items-center justify-center gap-space-xs hover:bg-primary-container transition-all shadow-md active:scale-95">
<span class="material-symbols-outlined text-[32px]">login</span>
<span class="text-headline-sm">CHECK-IN</span>
</button>
<button class="h-24 bg-secondary text-on-secondary rounded-xl flex flex-col items-center justify-center gap-space-xs hover:bg-secondary/90 transition-all shadow-md active:scale-95">
<span class="material-symbols-outlined text-[32px]">logout</span>
<span class="text-headline-sm">CHECK-OUT</span>
</button>
</div>
<div class="p-space-md bg-surface-container rounded-lg space-y-2">
<div class="flex justify-between text-body-sm text-on-surface-variant">
<span class="">Active Station Terminal</span>
<span class="font-mono text-on-surface">GT-PORT-04</span>
</div>
<div class="flex justify-between text-body-sm text-on-surface-variant">
<span class="">Gatekeeper Officer ID</span>
<span class="font-mono text-on-surface">SEC-OFF-882</span>
</div>
<div class="flex justify-between text-body-sm text-on-surface-variant">
<span class="">System Synchronization</span>
<span class="text-secondary font-medium">Optimal (0.04s)</span>
</div>
</div>
</div>
<!-- Visitation Session Logging Table -->
<div class="bg-surface-container-low p-space-lg rounded-lg">
<div class="flex items-center justify-between mb-space-md">
<h2 class="text-headline-sm text-primary flex items-center gap-space-sm">
<span class="material-symbols-outlined text-secondary">list_alt</span>
            Active Session Logs
          </h2>
<span class="text-label-sm text-on-surface-variant">Auto-updating</span>
</div>
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse">
<thead>
<tr class="border-b border-outline-variant text-label-sm text-on-surface-variant uppercase">
<th class="py-2 px-2">Visitor / Inmate</th>
<th class="py-2 px-2">Entry</th>
<th class="py-2 px-2">Status</th>
</tr>
</thead>
<tbody class="text-body-sm divide-y divide-outline-variant/30 text-on-surface">
<tr>
<td class="py-3 px-2">
<div class="font-semibold">Sarah Jenkins</div>
<div class="text-on-surface-variant">-&gt; Marcus Vance (#99402)</div>
</td>
<td class="py-3 px-2 font-mono">13:42:10</td>
<td class="py-3 px-2">
<span class="px-2 py-1 bg-secondary-fixed text-on-secondary-fixed text-label-sm rounded font-medium">On Site</span>
</td>
</tr>
<tr>
<td class="py-3 px-2">
<div class="font-semibold">David Ross (Atty)</div>
<div class="text-on-surface-variant">-&gt; Robert Taylor (#88104)</div>
</td>
<td class="py-3 px-2 font-mono">13:15:00</td>
<td class="py-3 px-2">
<span class="px-2 py-1 bg-secondary-fixed text-on-secondary-fixed text-label-sm rounded font-medium">On Site</span>
</td>
</tr>
<tr>
<td class="py-3 px-2">
<div class="font-semibold">Elena Rostova</div>
<div class="text-on-surface-variant">-&gt; Victor Hugo (#77391)</div>
</td>
<td class="py-3 px-2 font-mono">11:00:22</td>
<td class="py-3 px-2">
<span class="px-2 py-1 bg-surface-container text-on-surface-variant text-label-sm rounded font-medium">Exited (12:30)</span>
</td>
</tr>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div></main></div>

</body></html>